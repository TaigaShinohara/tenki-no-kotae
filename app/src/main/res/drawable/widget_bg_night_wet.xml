<?xml version="1.0" encoding="utf-8"?>
<!-- Widget face, wet night (v0.1.38): the night sky sunk deeper
     and greyer for rain / snow / thunder / fog, mirroring the app
     palette's dark weather casts. The pale night text colors are
     unchanged and gain contrast on the darker face; scanned per
     zone (docs/FEATURE_v0.1.38.md): weakest pair is the coldest
     band's headline color on the top stop, 8.36:1. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#131E2A"
        android:centerColor="#1D2B3A"
        android:endColor="#2A3138"
        android:type="linear" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1dp"
        android:color="#43536A" />
</shape>
