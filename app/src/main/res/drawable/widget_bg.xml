<?xml version="1.0" encoding="utf-8"?>
<!-- Widget face (v0.1.14; sky gradient v0.1.37): a piece of the
     app's night sky, fixed dark in both modes — deep sky blue at
     the top, settling into a dusky warm horizon at the bottom, so
     the widget carries concept A's sky onto the home screen. The
     24dp corner follows the app's radius token; the 1dp lighter
     edge is the specular ring's stand-in (a RemoteViews face has no
     layered glass, so the edge is a plain stroke). Text pairs were
     re-scanned per zone (docs/FEATURE_v0.1.37.md): the pale ink
     clears 4.98:1 on its weakest ground (the middle stop), the
     updated line 4.83:1 on the bottom stop. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#2C4A73"
        android:centerColor="#456A94"
        android:endColor="#5F5258"
        android:type="linear" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1dp"
        android:color="#54749E" />
</shape>
