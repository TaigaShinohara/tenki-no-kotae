<?xml version="1.0" encoding="utf-8"?>
<!-- Widget face (v0.1.14): deep slate glass, fixed dark in both modes.
     The 24dp corner follows the app's radius token; the 1dp lighter
     edge is the specular ring's stand-in (a RemoteViews face has no
     layered glass, so the edge is a plain stroke). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#26313D"
        android:endColor="#141A21"
        android:type="linear" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1dp"
        android:color="#3A4A5A" />
</shape>
