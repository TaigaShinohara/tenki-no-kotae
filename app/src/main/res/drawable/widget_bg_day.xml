<?xml version="1.0" encoding="utf-8"?>
<!-- Widget face, day (v0.1.38): the app's light sky itself —
     #8FB4E6 -> #C2DCF5 -> warm peach horizon #FDEBCB, the concept-A
     palette verbatim, so the launcher widget is a window onto the
     same sky the app shows. Text is the app's light ink / sub navy,
     set by TenkiWidgetProvider per face; scanned per zone
     (docs/FEATURE_v0.1.38.md): weakest pair is the city line's sub
     navy on the top stop, 4.91:1. The 24dp corner and 1dp edge
     follow widget_bg.xml. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#8FB4E6"
        android:centerColor="#C2DCF5"
        android:endColor="#FDEBCB"
        android:type="linear" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1dp"
        android:color="#7FA8E0" />
</shape>
